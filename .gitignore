# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local order + video storage
/.orders/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# The real prod/local credentials on this machine are named with an underscore,
# not a dot, so `.env*` above never matched them and `git add -A` would have
# committed the Stripe, Supabase service-role and Resend keys verbatim.
_env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

# Generated nurture-email previews (regenerate from /emails)
email-preview-*.html

# Local media & design-sync scratch (hundreds of MB, never belongs in git)
.ds-sync/
ds-bundle/
videos/
before after/
